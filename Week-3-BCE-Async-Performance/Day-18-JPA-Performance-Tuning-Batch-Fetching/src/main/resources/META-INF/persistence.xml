<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="PerformanceTuningPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.ee.lab.perf.entity.ServerNode</class>
        <class>com.ee.lab.perf.entity.TelemetryMetric</class>
        <class>com.ee.lab.perf.entity.SecurityAuditLog</class>
        <class>com.ee.lab.perf.entity.BatchedNode</class>

        <properties>
            <!-- Database Connection Settings (H2 In-Memory) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:perftuning;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Automatic Schema Generation -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>

            <!-- SQL Logging -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.highlight_sql" value="true"/>

            <!-- Hibernate Statistics Generation for Empirical Query Counting -->
            <property name="hibernate.generate_statistics" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
